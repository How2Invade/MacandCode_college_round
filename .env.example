# Handsfree Environment Configuration
# NOTE: Client-side Chrome extension code must NOT contain secret API keys.
# All LLM and secret service credentials belong in the secure backend environment only.

# Optional Secure Backend Server
BACKEND_PORT=4000
BACKEND_HOST=localhost

# Optional AI Backend Service (Only used by backend/ service, never bundled in extension)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# CLAUDE_API_KEY=your_anthropic_api_key_here

# Extension Dev Mode
VITE_ENABLE_DEBUG_LOGS=true
