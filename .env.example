# Handsfree Environment Configuration
# NOTE: Client-side Chrome extension code must NOT contain secret API keys.
# All LLM, LiveKit, and secret service credentials belong in the secure backend environment only.

# Backend Server Configuration
BACKEND_PORT=4000
BACKEND_HOST=localhost

# ------------------------------------------------------------------------------
# 1. LiveKit Real-Time WebRTC Voice Infrastructure
# Get free project at: https://cloud.livekit.io (Free Tier: 50GB bandwidth/month)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 2. Conversational LLM Providers (Multilingual: EN, HI, MR)
# Choose one or more:
# - Google Gemini (Free tier): https://aistudio.google.com/
# - Groq Llama 3.3 (Fast free tier): https://console.groq.com/
# - OpenAI: https://platform.openai.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# GROQ_API_KEY=your_groq_api_key
# OPENAI_API_KEY=your_openai_api_key
# CLAUDE_API_KEY=your_anthropic_api_key_here

# Sarvam handles speech synthesis for English, Hindi, and Marathi using SARVAM_API_KEY above.

# Extension Debug Mode
VITE_ENABLE_DEBUG_LOGS=true
